{
  "manifest_version": 3,
  "name": "Formly Autofill",
  "version": "4.4.2",
  "description": "Formly autofill engine. Activates only on forms opened through Formly.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://formly-c2wk.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Formly Autofill"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
